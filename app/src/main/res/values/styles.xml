<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.Zaticker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary colors (fallback) -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item> <!-- toolbar text fallback -->
        <item name="colorSecondary">@color/teal_200</item>

        <!-- Toolbar text fallback for A11 and below -->
        <item name="android:textColorPrimary">@color/toolbar_light_text</item>
    </style>

    <!-- White AlertDialog -->
    <style name="AlertDialogWhiteText" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AlertDialogButtonWhite</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AlertDialogButtonWhite</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AlertDialogButtonWhite</item>
    </style>

    <style name="AlertDialogButtonWhite" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
